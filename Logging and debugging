#ifndef LOG_H
#define LOG_H

#include <stdio.h>
#include <time.h>

// Log Levels
#define LOG_LEVEL_DEBUG 0
#define LOG_LEVEL_INFO  1
#define LOG_LEVEL_WARN  2
#define LOG_LEVEL_ERROR 3
#define LOG_LEVEL_NONE  4

// Default level is DEBUG, can be changed from gcc -D flag
#ifndef LOG_LEVEL
#define LOG_LEVEL LOG_LEVEL_DEBUG
#endif

// Color codes
#define COLOR_RESET  "\x1b[0m"
#define COLOR_DEBUG  "\x1b[36m" // Cyan
#define COLOR_INFO   "\x1b[32m" // Green
#define COLOR_WARN   "\x1b[33m" // Yellow
#define COLOR_ERROR  "\x1b[31m" // Red

#define LOG_FMT(color, level_str, fmt) \
    color "[" level_str "] %s:%d (%s) | " fmt COLOR_RESET "\n", __FILE__, __LINE__, __func__

// Main logging macros
#if LOG_LEVEL <= LOG_LEVEL_DEBUG
#define LOG_DEBUG(fmt, ...) fprintf(stderr, LOG_FMT(COLOR_DEBUG, "DEBUG", fmt), ##__VA_ARGS__)
#else
#define LOG_DEBUG(fmt, ...) // removed by preprocessor
#endif

#if LOG_LEVEL <= LOG_LEVEL_INFO
#define LOG_INFO(fmt, ...) fprintf(stderr, LOG_FMT(COLOR_INFO, "INFO ", fmt), ##__VA_ARGS__)
#else
#define LOG_INFO(fmt, ...) 
#endif

#if LOG_LEVEL <= LOG_LEVEL_WARN
#define LOG_WARN(fmt, ...) fprintf(stderr, LOG_FMT(COLOR_WARN, "WARN ", fmt), ##__VA_ARGS__)
#else
#define LOG_WARN(fmt, ...) 
#endif

#if LOG_LEVEL <= LOG_LEVEL_ERROR
#define LOG_ERROR(fmt, ...) fprintf(stderr, LOG_FMT(COLOR_ERROR, "ERROR", fmt), ##__VA_ARGS__)
#else
#define LOG_ERROR(fmt, ...) 
#endif

// Conditional Debugging - only if -DDEBUG is passed
#ifdef DEBUG
#define DEBUG_PRINT(fmt, ...) LOG_DEBUG(fmt, ##__VA_ARGS__)
#else
#define DEBUG_PRINT(fmt, ...) 
#endif

#endif
#include "log.h"

int divide(int a, int b) {
    LOG_DEBUG("Entering divide with a=%d, b=%d", a, b);
    if(b == 0) {
        LOG_ERROR("Division by zero attempted!");
        return 0;
    }
    LOG_INFO("Division successful");
    return a/b;
}

int main() {
    LOG_INFO("System Started");
    DEBUG_PRINT("This will only print in debug build");
    
    int x = 10, y = 0;
    LOG_WARN("y is %d, potential risk", y);
    
    divide(x, y);
    divide(x, 2);
    
    LOG_INFO("System Finished");
    return 0;
}

